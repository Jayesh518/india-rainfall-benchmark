# Copy to .env and fill in. .env is gitignored; this template is committed.

# --- D1 IMD gridded rainfall (imdlib) ----------------------------------------
# No key. Downloads directly from imdpune.gov.in.

# --- D2 IMDAA / NCMRWF -------------------------------------------------------
# Portal login, not an API key. Register at https://rds.ncmrwf.gov.in
NCMRWF_USERNAME=
NCMRWF_PASSWORD=

# --- D3 NASA POWER -----------------------------------------------------------
# No key required for the daily point API.

# --- D4 Open-Meteo -----------------------------------------------------------
# No key for non-commercial use. Set only if you hold a commercial licence.
OPENMETEO_API_KEY=

# --- Tracking ----------------------------------------------------------------
MLFLOW_TRACKING_URI=file:./mlruns
